<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- .NET tool identity. The package is DependencyInventory; the command is `depinv`. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>depinv</ToolCommandName>
    <PackageId>DependencyInventory</PackageId>
    <Title>Dependency Inventory</Title>

    <!-- Local/dev fallback only: the release workflow overrides it with -p:Version taken from the Git tag (v*). -->
    <Version>0.1.0-dev</Version>

    <Authors>Sylvain AURAT</Authors>
    <Copyright>© Sylvain Aurat 2026</Copyright>
    <Description>depinv inventories the NuGet references and the .NET target frameworks declared in the Git repositories of an Azure DevOps project or a GitLab group, and writes CSV and JSON reports.</Description>
    <PackageTags>nuget;dependencies;inventory;azure-devops;gitlab;dotnet-tool;cli</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>

    <!-- Icon of the executable (Windows). The installed `depinv` command is a shim generated by `dotnet tool install`,
         which does not carry it: it shows on DependencyInventory.exe when the tool is built or published. -->
    <ApplicationIcon>..\..\icon.ico</ApplicationIcon>
    <PackageProjectUrl>https://github.com/Reefact/dependency-inventory</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Reefact/dependency-inventory.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Source Link ships with the .NET SDK: these properties are enough to make the package debuggable. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" Version="0.57.2" />
  </ItemGroup>
</Project>
